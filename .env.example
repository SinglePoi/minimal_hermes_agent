# 复制为 .env 后填写（.env 已被 .gitignore 忽略）
DEEPSEEK_API_KEY=你的deepseek-key

# 向量检索：启用 Qwen text-embedding-v4（阿里云百炼，OpenAI 兼容）
MEMORY_PROVIDER=vector
EMBEDDING_BACKEND=api
EMBEDDING_API_KEY=你的dashscope-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

# 危险命令审批模式：manual（默认）| smart（辅助 LLM 评估）| off（旁路）
APPROVAL_MODE=smart
# 可选：追加给辅助 LLM 的自定义策略（如：涉及 /etc 的命令一律转人工）
# APPROVAL_SMART_POLICY=
# 可选：连续智能拒绝多少次后触发熔断（0 = 禁用）
# APPROVAL_DENIAL_BREAKER=3
# 会话历史保留天数：启动时清理不活跃旧会话（0 = 禁用）
SESSION_RETENTION_DAYS=90
# 记忆 nudge 间隔（用户轮次）：每 N 轮后台审查一次记忆（0 = 禁用）
MEMORY_NUDGE_INTERVAL=10
# turn 级预算：单次提问内"调模型"的最大轮数（防止模型无限调工具）
MAX_AGENT_TURNS=5
# 单次提问累计 prompt token 预算（0 = 不限制；触顶后请求模型收尾）
TURN_TOKEN_BUDGET=0
# LLM 自动生成会话标题（首轮交换后后台线程生成；false 关闭后不自动命名）
TITLE_GENERATION_ENABLED=true
# 调大模型失败时最多重试次数（429 限流/5xx/超时/断连才会重试；0 = 不重试）
LLM_MAX_RETRIES=3
# 可选：用户自定义拒绝规则（; 分隔的 fnmatch glob，命中即无条件拦截）
# APPROVAL_DENY=rm -rf *;git push --force*
# 可选：内容级安全扫描（tirith 简化版），默认开启；false 关闭
# TIRITH_ENABLED=true
# 可选：扫描器异常时放行（fail-open，默认）还是拦截（fail-closed）
# TIRITH_FAIL_OPEN=true

# HTTP 服务鉴权：设置后 API 需带 Authorization: Bearer <token>（生产务必设置；留空 = 不鉴权）
# SERVER_AUTH_TOKEN=你的服务token
# 操作审计日志路径（JSON Lines，每请求一行；留空 = 关闭审计）
AUDIT_LOG_PATH=audit.log

# 用户名密码登录（人机通道）：配了用户名+密码后，页面未登录跳 /login，API 需 session cookie
# 或 Bearer token；密码哈希用 python dashboard_auth.py hash-password <密码> 生成（推荐）
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD_HASH=scrypt$...
# DASHBOARD_PASSWORD=你的密码
# 会话签名密钥（≥16 字节随机值；不配则每次启动随机，重启后会话失效）
# DASHBOARD_AUTH_SECRET=随机32字节
# 会话有效期秒数（默认 12h，下限 60s）
DASHBOARD_SESSION_TTL_SECONDS=43200
# HTTPS 部署时设 true，给 session cookie 加 Secure
# DASHBOARD_COOKIE_SECURE=false

# 服务化日志（结构化 JSON Lines + 大小轮转；路径相对项目根目录）
SERVER_LOG_PATH=logs/server.log
SERVER_LOG_MAX_MB=5
SERVER_LOG_BACKUP_COUNT=3

# MCP 服务器配置路径（JSON；留空 = 禁用 MCP；文件已 gitignore，
# 密钥用 ${VAR} 插值从环境变量注入，不写进文件）
MCP_SERVERS_PATH=mcp_servers.json

# 工具结果落盘：超阈值结果先写盘、上下文只留预览（0/off = 关闭）
TOOL_RESULT_STORAGE_ENABLED=true
# 单工具结果落盘阈值（字符数）
TOOL_RESULT_MAX_CHARS=100000
# 单轮工具结果总预算（字符数），超限后从最大的结果开始落盘
TOOL_RESULT_TURN_BUDGET_CHARS=200000
# 落盘后保留在上下文里的预览字符数
TOOL_RESULT_PREVIEW_CHARS=1500
# 落盘目录（相对项目根目录或绝对路径；留空 = 系统临时目录）
# TOOL_RESULT_STORAGE_DIR=tool_results

# 网站访问策略：web_search/web_fetch 是否遵守禁访域名名单（默认关闭）
WEBSITE_POLICY_ENABLED=false
# 禁访域名名单（; 分隔，支持 *.domain.com 通配；留空 = 不额外拦截）
# WEBSITE_POLICY_DENY=internal.example.com;*.company.com

# 多代理/委派：delegate_task 子代理同步运行超时秒数（超时后中断子代理）
DELEGATE_TIMEOUT_SECONDS=120

# 终端后端：local（默认，本机执行）| daytona（Daytona 云沙箱，Linux）
# TERMINAL_ENV=local
# Daytona 云沙箱（TERMINAL_ENV=daytona 时必填；密钥只从环境变量注入）
# DAYTONA_API_KEY=你的daytona-key
# TERMINAL_DAYTONA_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
# TERMINAL_CONTAINER_CPU=1
# TERMINAL_CONTAINER_MEMORY=5120
# TERMINAL_CONTAINER_DISK=10240
# TERMINAL_CONTAINER_PERSISTENT=true

# 文件工具工作区根：配置后 read_file / write_file / patch / search_files
# 只能操作此目录内（相对路径也锚定到这里）。留空 = 不限制（相对路径跟进程 cwd）
# 注意：terminal 本机模式不受此变量约束；要隔离命令请用 TERMINAL_ENV=daytona
# WORKSPACE_ROOT=D:\your\workspace

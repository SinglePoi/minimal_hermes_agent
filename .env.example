# 复制为 .env 后填写（.env 已被 .gitignore 忽略）
DEEPSEEK_API_KEY=你的deepseek-key

# 向量检索：启用 Qwen text-embedding-v4（阿里云百炼，OpenAI 兼容）
MEMORY_PROVIDER=vector
EMBEDDING_BACKEND=api
EMBEDDING_API_KEY=你的dashscope-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

# 危险命令审批模式：manual（默认）| smart（辅助 LLM 评估）| off（旁路）
APPROVAL_MODE=smart
# 可选：追加给辅助 LLM 的自定义策略（如：涉及 /etc 的命令一律转人工）
# APPROVAL_SMART_POLICY=
# 可选：连续智能拒绝多少次后触发熔断（0 = 禁用）
# APPROVAL_DENIAL_BREAKER=3
# 会话历史保留天数：启动时清理不活跃旧会话（0 = 禁用）
SESSION_RETENTION_DAYS=90
# 记忆 nudge 间隔（用户轮次）：每 N 轮后台审查一次记忆（0 = 禁用）
MEMORY_NUDGE_INTERVAL=10
# 可选：用户自定义拒绝规则（; 分隔的 fnmatch glob，命中即无条件拦截）
# APPROVAL_DENY=rm -rf *;git push --force*
# 可选：内容级安全扫描（tirith 简化版），默认开启；false 关闭
# TIRITH_ENABLED=true
# 可选：扫描器异常时放行（fail-open，默认）还是拦截（fail-closed）
# TIRITH_FAIL_OPEN=true
